{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxpluslab/tiling-solvers/schemas/instance-v1.json",
  "title": "Tiling puzzle instance, format version 1",
  "description": "A puzzle as a solver sees it. Millimetres and radians. Polygons are strictly convex and counter-clockwise; a piece polygon is in local coordinates about its area centroid. The schema fixes the structure; convexity, orientation and centring are checked by the loader. No field may carry the answer: there are no reference poses, and unknown keys are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "regime", "units", "spanMm", "target", "pieces", "rules", "validation"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "regime": { "enum": ["footprint", "relief", "tropical-aware"] },
    "units": { "const": "mm" },
    "spanMm": { "type": "number", "exclusiveMinimum": 0 },
    "reliefMm": { "type": "number", "exclusiveMinimum": 0 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices"],
      "properties": { "vertices": { "$ref": "#/$defs/polygon" } }
    },
    "pieces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/piece" } },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translate", "rotate", "flip"],
      "properties": {
        "translate": { "const": true },
        "rotate": { "const": "continuous-z" },
        "flip": { "const": false }
      }
    },
    "validation": {
      "description": "Scale-relative tolerances as published by the source: lengths as fractions of spanMm, areaError as a fraction of the target area, roofMismatch as a fraction of reliefMm.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contactNoise", "overlapDepth", "outsideDepth", "areaError", "edgeAngleDeg", "edgeMinOverlap"],
      "properties": {
        "contactNoise": { "type": "number", "minimum": 0 },
        "overlapDepth": { "type": "number", "minimum": 0 },
        "outsideDepth": { "type": "number", "minimum": 0 },
        "areaError": { "type": "number", "minimum": 0 },
        "edgeAngleDeg": { "type": "number", "minimum": 0 },
        "edgeMinOverlap": { "type": "number", "minimum": 0 },
        "roofMismatch": { "type": "number", "minimum": 0 }
      }
    },
    "source": {
      "description": "Where a corpus instance came from. Synthetic instances have none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "puzzleId", "geometryHash"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "puzzleId": { "type": "string", "minLength": 1 },
        "geometryHash": { "type": "string", "minLength": 1 }
      }
    },
    "tropical": {
      "description": "Construction data, tropical-aware regime only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["construction", "pieceTerms"],
      "properties": {
        "construction": { "type": "object" },
        "pieceTerms": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "regime": { "const": "footprint" } } },
      "then": {
        "properties": {
          "reliefMm": false,
          "tropical": false,
          "pieces": { "items": { "properties": { "roof": false } } },
          "validation": { "properties": { "roofMismatch": false } }
        }
      },
      "else": {
        "required": ["reliefMm"],
        "properties": {
          "pieces": { "items": { "required": ["roof"] } },
          "validation": { "required": ["roofMismatch"] }
        }
      }
    },
    {
      "if": { "properties": { "regime": { "const": "tropical-aware" } } },
      "then": { "required": ["tropical"] },
      "else": { "properties": { "tropical": false } }
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2
    },
    "polygon": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polygon"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "polygon": { "$ref": "#/$defs/polygon" },
        "roof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["z0", "gx", "gy"],
          "properties": {
            "z0": { "type": "number" },
            "gx": { "type": "number" },
            "gy": { "type": "number" }
          }
        }
      }
    }
  }
}
