"""Type stubs for the Rust extension built from ``crates/tiling-py``.

A polygon is a sequence of ``(x, y)`` pairs, convex and counter-clockwise; a
pose is ``(x, y, theta)``; a roof is ``(z0, gx, gy)``. Millimetres and radians.
A polygon with fewer than three vertices raises ``ValueError``.
"""

from collections.abc import Sequence
from typing import final

_Point = Sequence[float]
_Polygon = Sequence[Sequence[float]]
_Pose = tuple[float, float, float]
_Roof = tuple[float, float, float]

def version() -> str: ...
def signed_area(polygon: _Polygon) -> float: ...
def centroid(polygon: _Polygon) -> tuple[float, float]: ...
def is_convex_ccw(polygon: _Polygon) -> bool: ...
def transform(polygon: _Polygon, pose: _Pose) -> list[tuple[float, float]]: ...
def contains_point(polygon: _Polygon, point: _Point) -> bool: ...
def point_outside_depth(point: _Point, container: _Polygon) -> float: ...
def outside_depth(polygon: _Polygon, container: _Polygon) -> float: ...
def penetration_depth(a: _Polygon, b: _Polygon) -> float: ...
def intersection(a: _Polygon, b: _Polygon) -> list[tuple[float, float]]: ...
def intersection_area(a: _Polygon, b: _Polygon) -> float: ...
def outside_area(polygon: _Polygon, container: _Polygon) -> float: ...

@final
class EdgeSignature:
    @property
    def length(self) -> float: ...
    @property
    def angle_start(self) -> float: ...
    @property
    def angle_end(self) -> float: ...
    @property
    def height_start(self) -> float | None: ...
    @property
    def height_end(self) -> float | None: ...
    @property
    def slope_along(self) -> float | None: ...
    @property
    def slope_across(self) -> float | None: ...

def edge_signatures(polygon: _Polygon, roof: _Roof | None = None) -> list[EdgeSignature]: ...
def roof_height(roof: _Roof, pose: _Pose, point: _Point) -> float: ...
def world_gradient(roof: _Roof, pose: _Pose) -> tuple[float, float]: ...
def seam_mismatch(
    roof_a: _Roof, pose_a: _Pose, roof_b: _Roof, pose_b: _Pose, p0: _Point, p1: _Point
) -> float: ...
def tangential_gradient_mismatch(
    roof_a: _Roof, pose_a: _Pose, roof_b: _Roof, pose_b: _Pose, p0: _Point, p1: _Point
) -> float: ...

@final
class Corner:
    @property
    def x(self) -> float: ...
    @property
    def y(self) -> float: ...
    @property
    def direction(self) -> float: ...
    @property
    def angle(self) -> float: ...
    @property
    def convex(self) -> bool: ...
    @property
    def source_piece(self) -> int | None: ...
    @property
    def source_edge(self) -> int: ...

@final
class Candidate:
    @property
    def piece(self) -> int: ...
    @property
    def x(self) -> float: ...
    @property
    def y(self) -> float: ...
    @property
    def theta(self) -> float: ...
    @property
    def vertex(self) -> int: ...
    @property
    def contact_piece(self) -> int | None: ...
    @property
    def contact_edge(self) -> int: ...
    @property
    def pose(self) -> _Pose: ...

@final
class PlacementCheck:
    @property
    def outside_mm(self) -> float: ...
    @property
    def overlap_mm(self) -> float: ...
    @property
    def blocker(self) -> int | None: ...
    @property
    def fits(self) -> bool: ...

@final
class Assembly:
    def __new__(
        cls,
        target: _Polygon,
        pieces: Sequence[_Polygon],
        roofs: Sequence[_Roof] | None = None,
        *,
        length_tol: float,
        angle_tol: float,
        slope_tol: float,
    ) -> Assembly: ...
    @property
    def piece_count(self) -> int: ...
    @property
    def edge_count(self) -> int: ...
    @property
    def arc_count(self) -> int: ...
    @property
    def all_placed(self) -> bool: ...
    def placed(self) -> list[int]: ...
    def pose(self, piece: int) -> _Pose | None: ...
    def classes(self) -> list[int]: ...
    def symmetry(self) -> list[int]: ...
    def compatible(
        self, fixed_piece: int | None, fixed_edge: int, piece: int, edge: int
    ) -> bool: ...
    def place(self, piece: int, pose: _Pose) -> None: ...
    def undo(self) -> int | None: ...
    def frontier(self) -> list[Corner]: ...
    def propose(self, corner: Corner) -> list[Candidate]: ...
    def check_placement(self, piece: int, pose: _Pose) -> PlacementCheck: ...
    def stats(self) -> tuple[int, int, int]: ...
