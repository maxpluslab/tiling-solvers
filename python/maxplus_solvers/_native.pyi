"""Type stubs for the Rust extension built from ``crates/tiling-py``.

A polygon is a sequence of ``(x, y)`` pairs, convex and counter-clockwise; a
pose is ``(x, y, theta)``; a roof is ``(z0, gx, gy)``. Millimetres and radians.
A polygon with fewer than three vertices raises ``ValueError``.
"""

from collections.abc import Sequence
from typing import final

_Point = Sequence[float]
_Polygon = Sequence[Sequence[float]]
_Pose = tuple[float, float, float]
_Roof = tuple[float, float, float]

def version() -> str: ...
def signed_area(polygon: _Polygon) -> float: ...
def centroid(polygon: _Polygon) -> tuple[float, float]: ...
def is_convex_ccw(polygon: _Polygon) -> bool: ...
def transform(polygon: _Polygon, pose: _Pose) -> list[tuple[float, float]]: ...
def contains_point(polygon: _Polygon, point: _Point) -> bool: ...
def point_outside_depth(point: _Point, container: _Polygon) -> float: ...
def outside_depth(polygon: _Polygon, container: _Polygon) -> float: ...
def penetration_depth(a: _Polygon, b: _Polygon) -> float: ...
def intersection(a: _Polygon, b: _Polygon) -> list[tuple[float, float]]: ...
def intersection_area(a: _Polygon, b: _Polygon) -> float: ...
def outside_area(polygon: _Polygon, container: _Polygon) -> float: ...

@final
class EdgeSignature:
    @property
    def length(self) -> float: ...
    @property
    def angle_start(self) -> float: ...
    @property
    def angle_end(self) -> float: ...
    @property
    def height_start(self) -> float | None: ...
    @property
    def height_end(self) -> float | None: ...
    @property
    def slope_along(self) -> float | None: ...
    @property
    def slope_across(self) -> float | None: ...

def edge_signatures(polygon: _Polygon, roof: _Roof | None = None) -> list[EdgeSignature]: ...
def roof_height(roof: _Roof, pose: _Pose, point: _Point) -> float: ...
def world_gradient(roof: _Roof, pose: _Pose) -> tuple[float, float]: ...
def seam_mismatch(
    roof_a: _Roof, pose_a: _Pose, roof_b: _Roof, pose_b: _Pose, p0: _Point, p1: _Point
) -> float: ...
def tangential_gradient_mismatch(
    roof_a: _Roof, pose_a: _Pose, roof_b: _Roof, pose_b: _Pose, p0: _Point, p1: _Point
) -> float: ...
